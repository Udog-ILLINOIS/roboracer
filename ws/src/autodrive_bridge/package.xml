<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autodrive_bridge</name>
  <version>0.0.0</version>
  <description>AutoDRIVE RoboRacer simulator bridge: Socket.IO to ROS 2, plus an adapter to the stack's topics.</description>
  <maintainer email="todo@todo.todo">SIGRobotics</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>control</exec_depend>   <!-- config/vehicle.yaml -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-gevent</exec_depend>
  <exec_depend>python3-gevent-websocket</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <!-- pip, see the Dockerfile: python-socketio==4.2.0 python-engineio==3.13.0, pinned on purpose
       (the sim's Socket.IO client needs these old protocol versions; rosdep has no keys for them) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
