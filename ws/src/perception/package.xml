<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception</name>
  <version>0.0.0</version>
  <description>Cartographer mapping and localization, particle filter (MCL) localization, saving maps to tracks/&lt;name&gt;/, and an experimental IMU EKF velocity estimate.</description>
  <maintainer email="todo@todo.todo">SIGRobotics</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cartographer_ros</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>slam_graph_tools</exec_depend>
  <exec_depend>cartographer_ros_msgs</exec_depend>
  <exec_depend>robot_localization</exec_depend>   <!-- ekf.launch.py -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>      <!-- mcl: distance field -->
  <exec_depend>python3-pil</exec_depend>        <!-- mcl: map.pgm -->
  <exec_depend>tf2_ros</exec_depend>            <!-- mcl: map -> odom, base_link -> laser -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
